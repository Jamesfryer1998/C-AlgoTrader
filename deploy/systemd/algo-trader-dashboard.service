[Unit]
Description=AlgoTrader dashboard (Dash via gunicorn), which starts and stops the C++ trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=algo
Group=algo
WorkingDirectory=/opt/algo-trader/app
# The Alpaca keys: a trader started from the dashboard inherits them
EnvironmentFile=/etc/algo-trader.env
Environment=PYTHONUNBUFFERED=1
# One worker: the backtests the dashboard starts are tracked in its memory. Threads handle concurrency.
ExecStart=/opt/algo-trader/env/bin/gunicorn --workers 1 --threads 8 --timeout 120 \
          --bind 0.0.0.0:8050 "dashboard.wsgi:server"
# Stop only the dashboard: a trader it started keeps trading through dashboard restarts and deploys
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
