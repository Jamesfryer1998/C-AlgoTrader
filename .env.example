# Copy this file to .env (which git ignores) and fill in your keys.
#   cp .env.example .env
#
# Alpaca API keys: alpaca.markets -> Paper Trading -> API Keys -> Generate
# Use paper keys with "trading_url": "https://paper-api.alpaca.markets" in src/config/config.json.
APCA_API_KEY_ID=your_key_id
APCA_API_SECRET_KEY=your_secret_key
